# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the new publishable key; anon key still works as fallback
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only — never expose to the browser
# New keys: sb_secret_...  |  Legacy: service_role JWT (eyJ...)
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Gemini via Coarena (OpenAI-compatible) — server only
AI_BASE_URL=https://coarena.ai/api/v1
AI_API_KEY=coa_...
AI_MODEL=gemini-3-8-flash
GEMINI_API_KEY=coa_...

# Staff and admin doors only. The judge desk does not use these.
STAFF_PASSWORD=choose-a-staff-password
ADMIN_PASSWORD=choose-an-admin-password
